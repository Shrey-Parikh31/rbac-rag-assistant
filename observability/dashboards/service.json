{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "description": "Fed by Prometheus scraping /metrics. Accurate about everything that reached the process, and silent about everything that did not.",
  "panels": [
    {
      "id": 9,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests per second, by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (route) (rate(kb_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "I"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests per second, by pod",
      "description": "Experiment 1 ended with one pod at its CPU limit and its healthy replacement serving nothing, for a full minute, with a 100% success rate and no alert able to fire. Two lines that do not sit on top of each other is that failure, and this panel is the only place it is visible.\n\nEmpty on Cloud Run, which runs one instance and does not expose a pod label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod, instance) (rate(kb_requests_total[1m]))",
          "legendFormat": "{{pod}}{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "J"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "pointSize": 5
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "The two objectives",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "How fast the budget is burning",
      "description": "1 means the month's budget is being spent in exactly a month, which is the objective met and nothing more. 14.4 spends 2% of it in an hour and pages; 6 pages more slowly; sustained 1 files a ticket. The thresholds on this panel are the same numbers as the alerts in reliability/alerts.yaml, so a graph that looks alarming and a pager that stays quiet mean the alert needs looking at.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(kb_requests_total{route=\"/search\",code=~\"5..\"}[1h])) / sum(rate(kb_requests_total{route=\"/search\"}[1h]))) / 0.005",
          "legendFormat": "availability, 1h window",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "K"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(1 - sum(rate(kb_request_duration_seconds_bucket{route=\"/search\",le=\"0.05\"}[1h])) / sum(rate(kb_request_duration_seconds_count{route=\"/search\"}[1h]))) / 0.01",
          "legendFormat": "latency, 1h window",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "L"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "pointSize": 5,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Search latency, measured at the server",
      "description": "The 50ms line is the objective. The 30ms line is the budget CI enforces with k6, deliberately tighter so a regression fails a build instead of spending the budget.\n\nA p50 sitting almost exactly on 40ms with no spread is not load: it is the delayed-ACK interaction from ADR-18, and the fix is one socket option, not more replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kb_request_duration_seconds_bucket{route=\"/search\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "M"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kb_request_duration_seconds_bucket{route=\"/search\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "N"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kb_request_duration_seconds_bucket{route=\"/search\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "O"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "pointSize": 5,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.03
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Failures that return 200",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "What searches came back as",
      "description": "answer, restricted, no_match. There is no ground truth here, so this cannot say whether an answer was right. What it says is the mix, and a mix that swings to all no_match is an index that has stopped working while every request still returns 200. About a fifth of the golden set correctly has no answer, so the alert fires above half, not above zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(kb_search_outcomes_total[15m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "P"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "pointSize": 5,
            "stacking": {
              "mode": "percent",
              "group": "A"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "state-timeline",
      "title": "Circuit breaker",
      "description": "Open means the model provider has failed three times in a row and /ask is refusing immediately rather than making every user wait out the timeout. That is the system working, and it used to be visible only in stderr on one pod.\n\n/search is unaffected: it does not call the provider at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kb_breaker_state",
          "legendFormat": "{{pod}}{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "Q"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "open",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "probing",
                  "color": "yellow",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "alignValue": "center"
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Token rotation",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "state-timeline",
      "title": "Which token map each process is honouring",
      "description": "A fingerprint of the map, so every process honouring the same tokens shows the same value. During a rotation the rows disagree; when they agree again, the revocation has taken effect everywhere.\n\nPostmortem 004 could only answer that by probing the old and new tokens in a loop through the Service until the answers stopped contradicting each other, and the measured window was 53 seconds. The rows on this panel are the same 53 seconds, without the loop.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kb_tokens_version",
          "legendFormat": "{{pod}}{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "R"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "alignValue": "center"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "rbac-rag-assistant"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "label": "Prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Assistant: inside the process",
  "uid": "kb-service-internal",
  "version": 1,
  "weekStart": ""
}
