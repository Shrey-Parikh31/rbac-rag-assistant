{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "description": "Fed by observability/probe.py, which asks from a machine outside the deployment on a schedule. Everything here counts requests the server cannot count, including the ones it never received.",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is the promise being kept?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability, 30 days",
      "description": "The fraction of probes that got a correct answer to a known question. Objective is 99.5%. This is measured from a machine outside the deployment, so unlike the server's own error ratio it counts requests that never reached the process: a refused connection, a DNS failure, an expired certificate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * avg_over_time(kb_probe_up{check=\"search_hit\"}[30d])",
          "legendFormat": "measured from outside",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99.0
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          },
          "unit": "percent",
          "decimals": 3,
          "min": 95,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Error budget left",
      "description": "0.5% of 30 days is about 3.6 hours of outage the service is allowed. This is how much of it is unspent. Below zero the objective has been missed for the month, and the response is to stop shipping features and fix reliability, which is the only thing an error budget is for.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - (1 - avg_over_time(kb_probe_up{check=\"search_hit\"}[30d])) / 0.005)",
          "legendFormat": "of the 0.5% budget",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": -20,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Access control, last 24h",
      "description": "The one rule this project exists to enforce, checked from outside on every run. `min_over_time` rather than the latest value on purpose: a leak that happened six hours ago and stopped still happened, and a panel showing only 'fine right now' would hide it until the next 24 hours rolled past.\n\nEvery one of these can fail while availability and latency stay perfect. That is what makes them worth a panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min_over_time(kb_probe_up{check=\"unauthenticated\"}[24h])",
          "legendFormat": "strangers refused",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min_over_time(kb_probe_up{check=\"search_refused\"}[24h])",
          "legendFormat": "restricted material withheld",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min_over_time(kb_probe_up{check=\"corpus\"}[24h])",
          "legendFormat": "catalogue not naming hidden documents",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "E"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "BROKEN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "holding",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "What a user actually waits",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Round trip, from outside",
      "description": "Wall clock, including DNS, TLS, the network, and any time the platform spent starting a container. The server's own latency histogram starts counting after all of that, so these numbers are much larger and they are the honest ones.\n\nSpikes to several seconds on an otherwise flat line are cold starts, not incidents: Cloud Run is configured to scale to zero, and the probe is often the first request in a while.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kb_probe_duration_seconds",
          "legendFormat": "{{check}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "F"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "pointSize": 5
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cold starts in the last 24h",
      "description": "A health check has no work to do, so anything over a second is the platform, not the code. This counts the blind spot named in reliability/README.md rather than leaving it as a caveat: these users waited, and no server-side metric recorded it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count_over_time((kb_probe_duration_seconds{check=\"health\"} > 1)[24h:])",
          "legendFormat": "probes that waited on a container",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "G"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 14,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failures by cause",
      "description": "status: answered, wrongly. content: answered, with the wrong thing. leak: answered a question it should have refused. timeout: up and unusable. connection: nothing listening. tls: a certificate problem, which looks like an outage and is not one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (kb_probe_up == 0)",
          "legendFormat": "{{reason}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "H"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 14,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "rbac-rag-assistant"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "label": "Prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Assistant: the promise, from outside",
  "uid": "kb-slo-external",
  "version": 1,
  "weekStart": ""
}
